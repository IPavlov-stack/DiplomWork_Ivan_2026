<Window x:Class="DiplomWork_Ivan_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SCADA - Vacuum Dryer"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#595959">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT CONTROL PANEL -->
        <Border Grid.Column="0"
                Background="#2B2B2B"
                BorderBrush="#555"
                BorderThickness="1"
                Padding="15"
                CornerRadius="6">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Vacuum Dryer Control"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Material:" Foreground="White"/>
                    <ComboBox x:Name="MaterialComboBox"
                              Height="30"
                              Margin="0,0,0,10"
                              SelectionChanged="MaterialComboBox_SelectionChanged"/>

                    <TextBlock Text="Temperature Setpoint [°C]:"
                               Foreground="White"/>
                    <TextBox x:Name="TemperatureSetpointTextBox"
                             Text="60"
                             Height="28"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Pressure Setpoint [kPa]:"
                               Foreground="White"/>
                    <TextBox x:Name="PressureSetpointTextBox"
                             Text="30"
                             Height="28"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Operation Mode:"
                               Foreground="White"/>
                    <ComboBox x:Name="OperationModeComboBox"
                              Height="30"
                              Margin="0,0,0,15"
                              SelectedIndex="0"
                              SelectionChanged="OperationModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Manual"/>
                    </ComboBox>
                    <TextBlock Text="Temperature Control:"
                               Foreground="#E0E0E0"
                               Margin="0,10,0,0"/>

                    <ComboBox x:Name="TemperatureControlComboBox"
                              Height="30"
                              SelectedIndex="1"
                              SelectionChanged="TemperatureControlComboBox_SelectionChanged">
                        <ComboBoxItem Content="ON/OFF"/>
                        <ComboBoxItem Content="PID"/>
                    </ComboBox>
                    <TextBlock Text="Drying Mode:"
                               Foreground="White"
                               Margin="0,10,0,0"/>

                    <ComboBox x:Name="DryingModeComboBox"
                              Height="30"
                              Margin="0,0,0,10"
                              SelectedIndex="1"
                              SelectionChanged="DryingModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Soft"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Hard"/>
                    </ComboBox>

                    <TextBlock x:Name="DryingRecipeInfoTextBlock"
                               Text="Select a material and drying mode."
                               Foreground="#BDBDBD"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>

                    <!-- START / STOP buttons on one row -->
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartButton"
                                Grid.Column="0"
                                Content="START"
                                Height="42"
                                FontWeight="Bold"
                                Margin="0,0,5,0"
                                Click="StartButton_Click">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#1B5E20"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="2">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#111111"/>
                                            <Setter Property="Foreground" Value="#777777"/>
                                            <Setter Property="BorderBrush" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="StopButton"
                                Grid.Column="1"
                                Content="STOP"
                                Height="42"
                                FontWeight="Bold"
                                Background="#C62828"
                                Foreground="White"
                                Margin="5,0,0,0"
                                Click="StopButton_Click"/>
                    </Grid>

                    <!-- RESET button under START / STOP -->
                    <Button x:Name="ResetButton"
                        Content="RESTART"
                        Height="42"
                        FontWeight="Bold"
                        Background="#F57C00"
                        Foreground="White"
                        Margin="0,10,0,0"
                        Click="ResetButton_Click"/>

                    <Button x:Name="EmergencyStopButton"
                            Content="EMERGENCY STOP"
                            Height="48"
                            FontWeight="Bold"
                            Background="#B71C1C"
                            Foreground="White"
                            Margin="0,10,0,0"
                            Click="EmergencyStopButton_Click"/>

                    <Button x:Name="ResetSafetyButton"
                            Content="RESET SAFETY"
                            Height="38"
                            FontWeight="Bold"
                            Background="#795548"
                            Foreground="White"
                            Margin="0,8,0,0"
                            Click="ResetSafetyButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

            <!-- RIGHT HMI AREA -->
            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="304*"/>
                    <RowDefinition Height="11*"/>
                    <RowDefinition Height="31.4"/>
                    <RowDefinition Height="138.6"/>
                </Grid.RowDefinitions>

                <!-- STATUS HEADER -->
                <Border Grid.Row="0"
            Background="#252525"
            CornerRadius="5"
            Padding="15"
            Margin="-4,0,14,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="0"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center">
                        <Run Text="Status: " Foreground="White"/>
                        <Run x:Name="StatusValueRun" Text="Stopped" Foreground="Red"/>
                    </TextBlock>

                    <TextBlock x:Name="ProcessStageTextBlock"
                               Grid.Column="1"
                               Text="Stage: Idle"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Simulation speed:"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="SimulationSpeedComboBox"
                                  Width="85"
                                  Height="32"
                                  FontSize="15"
                                  SelectedIndex="0"
                                  SelectionChanged="SimulationSpeedComboBox_SelectionChanged">
                            <ComboBoxItem Content="1×" Tag="1"/>
                            <ComboBoxItem Content="10×" Tag="10"/>
                            <ComboBoxItem Content="60×" Tag="60"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HMI PROCESS DIAGRAM -->
            <Border Grid.Row="1"
                    Background="#252525"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="-4,15,14,15" Grid.RowSpan="2">

                <Canvas>

                    <!-- Main vacuum chamber -->
                    <Border Canvas.Left="330"
                            Canvas.Top="90"
                            Width="190"
                            Height="260"
                            Background="#3A3A3A"
                            BorderBrush="#AAAAAA"
                            BorderThickness="3"
                            CornerRadius="45">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="VACUUM"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="DRYER"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="CHAMBER"
                                       Foreground="LightGray"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Heater -->
                    <Rectangle Canvas.Left="65"
                               Canvas.Top="170"
                               Width="130"
                               Height="70"
                               Fill="#444"
                               Stroke="#AAAAAA"
                               StrokeThickness="2"/>
                    <TextBlock Canvas.Left="92"
                               Canvas.Top="195"
                               Text="HEATER"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <!-- Heater pipe -->
                    <Line Canvas.Left="195"
                          Canvas.Top="205"
                          X1="0"
                          Y1="0"
                          X2="135"
                          Y2="0"
                          Stroke="#CC3300"
                          StrokeThickness="8"/>

                    <!-- Fan -->
                    <Ellipse Canvas.Left="205"
                             Canvas.Top="255"
                             Width="80"
                             Height="80"
                             Fill="#444"
                             Stroke="#AAAAAA"
                             StrokeThickness="2"/>
                    <TextBlock Canvas.Left="230"
                               Canvas.Top="285"
                               Text="FAN"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <!-- Fan pipe -->
                    <Line Canvas.Left="285"
                          Canvas.Top="295"
                          X1="0"
                          Y1="0"
                          X2="45"
                          Y2="0"
                          Stroke="#4FC3F7"
                          StrokeThickness="6"/>

                    <!-- Vacuum pump -->
                    <Ellipse Canvas.Left="620"
                             Canvas.Top="165"
                             Width="110"
                             Height="110"
                             Fill="#444"
                             Stroke="#AAAAAA"
                             StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Canvas.Left="652"
                               Canvas.Top="205"
                               Text="PUMP"
                               Foreground="White"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- Pump pipe -->
                    <Line Canvas.Left="520"
                          Canvas.Top="220"
                          X1="0"
                          Y1="0"
                          X2="100"
                          Y2="0"
                          Stroke="#4FC3F7"
                          StrokeThickness="8" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- Exhaust line -->
                    <Line Canvas.Left="730"
                          Canvas.Top="220"
                          X1="0"
                          Y1="0"
                          X2="80"
                          Y2="0"
                          Stroke="#4FC3F7"
                          StrokeThickness="6" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Canvas.Left="760"
                               Canvas.Top="190"
                               Text="Vacuum line"
                               Foreground="LightGray" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- Controlled vent valve -->
                    <Line Canvas.Left="425"
                          Canvas.Top="35"
                          X1="0"
                          Y1="0"
                          X2="0"
                          Y2="55"
                          Stroke="#B0BEC5"
                          StrokeThickness="6"/>
                    <Rectangle Canvas.Left="395"
                               Canvas.Top="15"
                               Width="60"
                               Height="25"
                               Fill="#444"
                               Stroke="#AAAAAA"
                               StrokeThickness="2"/>
                    <TextBlock Canvas.Left="405"
                               Canvas.Top="19"
                               Text="VENT"
                               Foreground="White"
                               FontWeight="Bold"/>
                    <Ellipse x:Name="VentValveLamp"
                             Canvas.Left="465"
                             Canvas.Top="17"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White"/>

                    <!-- Sensor labels near chamber -->
                    <Border Canvas.Left="313"
                            Canvas.Top="394"
                            Background="#2A2A2A"
                            BorderBrush="#555"
                            BorderThickness="1"
                            Padding="10">

                        <StackPanel>
                            <TextBlock x:Name="TemperatureTextBlock"
                                       Text="Chamber Temperature: 20.0 °C"
                                       Foreground="White"
                                       FontSize="15"/>

                            <TextBlock x:Name="MaterialTemperatureTextBlock"
                                       Text="Material Temperature: 20.0 °C"
                                       Foreground="White"
                                       FontSize="15"/>

                            <TextBlock x:Name="PressureTextBlock"
                                       Text="Pressure: 101.3 kPa"
                                       Foreground="White"
                                       FontSize="15"/>

                            <TextBlock x:Name="MoistureTextBlock"
                                       Text="Material Moisture: 60.0 %"
                                       Foreground="White"
                                       FontSize="15"/>
                        </StackPanel>
                    </Border>


                    <!-- Status lamps -->
                    <Ellipse x:Name="HeaterLamp"
                             Canvas.Left="105"
                             Canvas.Top="250"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White"/>
                    <TextBlock Canvas.Left="135"
                               Canvas.Top="250"
                               Text="Heater"
                               Foreground="White"/>

                    <Ellipse x:Name="FanLamp"
                             Canvas.Left="220"
                             Canvas.Top="345"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White"/>
                    <TextBlock Canvas.Left="250"
                               Canvas.Top="345"
                               Text="Fan"
                               Foreground="White"/>

                    <Ellipse x:Name="PumpLamp"
                             Canvas.Left="660"
                             Canvas.Top="290"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Canvas.Left="690"
                               Canvas.Top="290"
                               Text="Pump"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                </Canvas>
            </Border>



                            <!-- BOTTOM MEASUREMENTS PANEL -->
                            <Border Grid.Row="3"
                        Background="#2B2B2B"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15" Grid.RowSpan="2" Margin="-4,0,14,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Actuators -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Actuators"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock x:Name="HeaterTextBlock"
                       Text="Heater: 0 %"
                       Foreground="White"
                       FontSize="16"/>

                        <TextBlock x:Name="PumpTextBlock"
                       Text="Vacuum Pump: 0 %"
                       Foreground="White"
                       FontSize="16"/>

                        <TextBlock x:Name="VentValveTextBlock"
                       Text="Vent Valve: 0 %"
                       Foreground="White"
                       FontSize="16"/>

                        <TextBlock x:Name="FanTextBlock"
                       Text="Fan: 0 %"
                       Foreground="White"
                       FontSize="16"/>
                    </StackPanel>

                    <!-- Process Summary -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Process Summary"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock x:Name="TimeTextBlock"
                       Text="Time: 0 s"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="MoistureRatioTextBlock"
                       Text="Moisture Ratio: 1.000"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="RemainingTimeTextBlock"
                       Text="Estimated Remaining: calculating..."
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="VacuumLevelTextBlock"
                       Text="Vacuum Level: 0.0 %"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="TotalEnergyTextBlock"
                       Text="Total Energy: 0.000 kWh"
                       Foreground="White"
                       FontSize="15"/>

                        <TextBlock x:Name="SensorStatusTextBlock"
                       Text="Sensors: OK"
                       Foreground="LightGreen"
                       FontSize="15"/>
                    </StackPanel>

                    <!-- Alarms -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Alarms"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                        <TextBlock x:Name="AlarmsTextBlock"
                       Text="No active alarms"
                       Foreground="LightGreen"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Border>

                        </Grid>
                        <!-- RIGHT SIDE PANEL -->
                        <Border Grid.Column="2"
                        Background="#252525"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="Navigation"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1">

                    <Button x:Name="DetailsButton"
                    Content="DETAILS"
                    Height="42"
                    FontWeight="Bold"
                    Background="#455A64"
                    Foreground="White"
                    Margin="0,0,0,10"
                    Click="DetailsButton_Click"/>

                    <Button x:Name="ShowTrendsButton"
                    Content="TRENDS"
                    Height="42"
                    FontWeight="Bold"
                    Background="#1565C0"
                    Foreground="White"
                    Margin="0,0,0,10"
                    Click="ShowTrendsButton_Click"/>

                    <Button x:Name="ShowAlarmsButton"
                    Content="ALARMS"
                    Height="42"
                    FontWeight="Bold"
                    Background="#6A1B9A"
                    Foreground="White"
                    Margin="0,0,0,10"
                    Click="ShowAlarmsButton_Click"/>
                </StackPanel>

                <GroupBox Grid.Row="2"
                  Header="Context / Controls"
                  Foreground="White"
                  BorderBrush="#777"
                  Margin="0,20,0,20"
                  Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ContextPanelTitleTextBlock"
                                       Text="Actuator Control"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="ContextPanelModeTextBlock"
                                       Text="Auto mode: controller outputs"
                                       Foreground="LightGray"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Heater Power [%]" Foreground="White"/>
                            <TextBlock x:Name="ManualHeaterValueTextBlock"
                                       Text="0 %" Foreground="LightGray"/>
                            <Slider x:Name="ManualHeaterSlider"
                                    Minimum="0" Maximum="100" Value="0"
                                    ValueChanged="ManualSlider_ValueChanged"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Vacuum Pump [%]" Foreground="White"/>
                            <TextBlock x:Name="ManualPumpValueTextBlock"
                                       Text="0 %" Foreground="LightGray"/>
                            <Slider x:Name="ManualPumpSlider"
                                    Minimum="0" Maximum="100" Value="0"
                                    ValueChanged="ManualSlider_ValueChanged"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Vent Valve [%]" Foreground="White"/>
                            <TextBlock x:Name="ManualVentValveValueTextBlock"
                                       Text="0 %" Foreground="LightGray"/>
                            <Slider x:Name="ManualVentValveSlider"
                                    Minimum="0" Maximum="100" Value="0"
                                    ValueChanged="ManualSlider_ValueChanged"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Fan Speed [%]" Foreground="White"/>
                            <TextBlock x:Name="ManualFanValueTextBlock"
                                       Text="70 %" Foreground="LightGray"/>
                            <Slider x:Name="ManualFanSlider"
                                    Minimum="0" Maximum="100" Value="70"
                                    ValueChanged="ManualSlider_ValueChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <Button x:Name="ExitButton"
                Grid.Row="3"
                Content="EXIT"
                Height="42"
                FontWeight="Bold"
                Background="#424242"
                Foreground="White"
                Click="ExitButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
