<Window x:Class="DiplomWork_Ivan_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SCADA - Vacuum Dryer"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#878787">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT CONTROL PANEL -->
        <Border Grid.Column="0"
                Background="#2B2B2B"
                BorderBrush="#555"
                BorderThickness="1"
                Padding="15"
                CornerRadius="6">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Vacuum Dryer Control"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Material:" Foreground="White"/>
                    <ComboBox x:Name="MaterialComboBox"
                              Height="30"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Temperature Setpoint [°C]:"
                               Foreground="White"/>
                    <TextBox x:Name="TemperatureSetpointTextBox"
                             Text="60"
                             Height="28"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Pressure Setpoint [kPa]:"
                               Foreground="White"/>
                    <TextBox x:Name="PressureSetpointTextBox"
                             Text="30"
                             Height="28"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Operation Mode:"
                               Foreground="White"/>
                    <ComboBox x:Name="OperationModeComboBox"
                              Height="30"
                              Margin="0,0,0,15"
                              SelectedIndex="0"
                              SelectionChanged="OperationModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Manual"/>
                    </ComboBox>

                    <GroupBox Header="Manual Control"
                              Foreground="White"
                              Margin="0,0,0,15">
                        <StackPanel Margin="8">

                            <TextBlock Text="Manual Heater Power [%]:"
                                       Foreground="White"/>
                            <TextBlock x:Name="ManualHeaterValueTextBlock"
                                       Text="0 %"
                                       Foreground="LightGray"/>
                            <Slider x:Name="ManualHeaterSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    ValueChanged="ManualSlider_ValueChanged"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Manual Pump Power [%]:"
                                       Foreground="White"/>
                            <TextBlock x:Name="ManualPumpValueTextBlock"
                                       Text="0 %"
                                       Foreground="LightGray"/>
                            <Slider x:Name="ManualPumpSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    ValueChanged="ManualSlider_ValueChanged"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Manual Fan Speed [%]:"
                                       Foreground="White"/>
                            <TextBlock x:Name="ManualFanValueTextBlock"
                                       Text="70 %"
                                       Foreground="LightGray"/>
                            <Slider x:Name="ManualFanSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="70"
                                    ValueChanged="ManualSlider_ValueChanged"/>

                        </StackPanel>
                    </GroupBox>

                    <Button x:Name="StartButton"
                            Content="START"
                            Height="42"
                            FontWeight="Bold"
                            Background="#2E7D32"
                            Foreground="White"
                            Margin="0,0,0,10"
                            Click="StartButton_Click"/>

                    <Button x:Name="StopButton"
                            Content="STOP"
                            Height="42"
                            FontWeight="Bold"
                            Background="#B71C1C"
                            Foreground="White"
                            Click="StopButton_Click"/>
                    <Button x:Name="ShowTrendsButton"
                            Content="TRENDS"
                            Height="42"
                            FontWeight="Bold"
                            Background="#1565C0"
                            Foreground="White"
                            Margin="0,10,0,0"
                            Click="ShowTrendsButton_Click"/>
                    <Button x:Name="ShowAlarmsButton"
                            Content="ALARMS"
                            Height="42"
                            FontWeight="Bold"
                            Background="#6A1B9A"
                            Foreground="White"
                            Margin="0,10,0,0"
                            Click="ShowAlarmsButton_Click"/>
                    <Button x:Name="ExitButton"
                            Content="EXIT"
                            Height="42"
                            FontWeight="Bold"
                            Background="#424242"
                            Foreground="White"
                            Margin="0,10,0,0"
                            Click="ExitButton_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT HMI AREA -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- STATUS HEADER -->
            <Border Grid.Row="0"
                    Background="#2B2B2B"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15">

                <TextBlock x:Name="StatusTextBlock"
                           Text="Status: Stopped"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- HMI PROCESS DIAGRAM -->
            <Border Grid.Row="1"
                    Background="#252525"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,15,0,15">

                <Canvas>

                    <!-- Main vacuum chamber -->
                    <Border Canvas.Left="330"
                            Canvas.Top="90"
                            Width="190"
                            Height="260"
                            Background="#3A3A3A"
                            BorderBrush="#AAAAAA"
                            BorderThickness="3"
                            CornerRadius="45">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="VACUUM"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="DRYER"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="CHAMBER"
                                       Foreground="LightGray"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Heater -->
                    <Rectangle Canvas.Left="65"
                               Canvas.Top="170"
                               Width="130"
                               Height="70"
                               Fill="#444"
                               Stroke="#AAAAAA"
                               StrokeThickness="2"/>
                    <TextBlock Canvas.Left="92"
                               Canvas.Top="195"
                               Text="HEATER"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <!-- Heater pipe -->
                    <Line Canvas.Left="195"
                          Canvas.Top="205"
                          X1="0"
                          Y1="0"
                          X2="135"
                          Y2="0"
                          Stroke="#CC3300"
                          StrokeThickness="8"/>

                    <!-- Fan -->
                    <Ellipse Canvas.Left="205"
                             Canvas.Top="255"
                             Width="80"
                             Height="80"
                             Fill="#444"
                             Stroke="#AAAAAA"
                             StrokeThickness="2"/>
                    <TextBlock Canvas.Left="230"
                               Canvas.Top="285"
                               Text="FAN"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <!-- Fan pipe -->
                    <Line Canvas.Left="285"
                          Canvas.Top="295"
                          X1="0"
                          Y1="0"
                          X2="45"
                          Y2="0"
                          Stroke="#4FC3F7"
                          StrokeThickness="6"/>

                    <!-- Vacuum pump -->
                    <Ellipse Canvas.Left="620"
                             Canvas.Top="175"
                             Width="110"
                             Height="110"
                             Fill="#444"
                             Stroke="#AAAAAA"
                             StrokeThickness="2"/>
                    <TextBlock Canvas.Left="652"
                               Canvas.Top="215"
                               Text="PUMP"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <!-- Pump pipe -->
                    <Line Canvas.Left="520"
                          Canvas.Top="220"
                          X1="0"
                          Y1="0"
                          X2="100"
                          Y2="0"
                          Stroke="#4FC3F7"
                          StrokeThickness="8"/>

                    <!-- Exhaust line -->
                    <Line Canvas.Left="730"
                          Canvas.Top="230"
                          X1="0"
                          Y1="0"
                          X2="80"
                          Y2="0"
                          Stroke="#4FC3F7"
                          StrokeThickness="6"/>
                    <TextBlock Canvas.Left="760"
                               Canvas.Top="200"
                               Text="Vacuum line"
                               Foreground="LightGray"/>

                    <!-- Sensor labels near chamber -->
                    <Border Canvas.Left="330"
                            Canvas.Top="365"
                            Width="190"
                            Height="115"
                            Background="#303030"
                            BorderBrush="#666"
                            BorderThickness="1"
                            Padding="8">

                        <StackPanel>
                            <TextBlock x:Name="TemperatureTextBlock"
                                       Text="Temperature: 20 °C"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="PressureTextBlock"
                                       Text="Pressure: 101.3 kPa"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="MoistureTextBlock"
                                       Text="Material Moisture: 0 %"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="AirHumidityTextBlock"
                                       Text="Air Humidity: 0 %"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="TargetMoistureTextBlock"
                                       Text="Target Moisture: 0 %"
                                       Foreground="White"
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Status lamps -->
                    <Ellipse x:Name="HeaterLamp"
                             Canvas.Left="105"
                             Canvas.Top="250"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White"/>
                    <TextBlock Canvas.Left="135"
                               Canvas.Top="250"
                               Text="Heater"
                               Foreground="White"/>

                    <Ellipse x:Name="FanLamp"
                             Canvas.Left="220"
                             Canvas.Top="345"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White"/>
                    <TextBlock Canvas.Left="250"
                               Canvas.Top="345"
                               Text="Fan"
                               Foreground="White"/>

                    <Ellipse x:Name="PumpLamp"
                             Canvas.Left="660"
                             Canvas.Top="300"
                             Width="22"
                             Height="22"
                             Fill="Gray"
                             Stroke="White"/>
                    <TextBlock Canvas.Left="690"
                               Canvas.Top="300"
                               Text="Pump"
                               Foreground="White"/>

                </Canvas>
            </Border>

            <!-- BOTTOM MEASUREMENTS PANEL -->
            <Border Grid.Row="2"
                    Background="#2B2B2B"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Actuators"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="HeaterTextBlock"
                                   Text="Heater: 0 %"
                                   Foreground="White"
                                   FontSize="16"/>

                        <TextBlock x:Name="PumpTextBlock"
                                   Text="Vacuum Pump: 0 %"
                                   Foreground="White"
                                   FontSize="16"/>

                        <TextBlock x:Name="FanTextBlock"
                                   Text="Fan: 0 %"
                                   Foreground="White"
                                   FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Trends"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="TimeTextBlock"
                                   Text="Time: 0 s"
                                   Foreground="White"
                                   FontSize="16"/>

                        <TextBlock x:Name="TrendPointsTextBlock"
                                   Text="Trend points: 0"
                                   Foreground="White"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>

                     
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Alarms"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="AlarmsTextBlock"
                                   Text="No active alarms"
                                   Foreground="LightGreen"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Alarm History"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Margin="0,5,0,5"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>