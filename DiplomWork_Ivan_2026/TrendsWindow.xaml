<Window x:Class="DiplomWork_Ivan_2026.TrendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Trends"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#595959"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Vacuum Dryer Process Trends"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Content="CLOSE"
                    Width="100"
                    Height="40"
                    Background="#B71C1C"
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"/>
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="1"
                Background="#252525"
                BorderBrush="#555"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Selected trend:"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="TrendComboBox"
                          Grid.Column="1"
                          Height="32"
                          FontSize="15"
                          SelectedIndex="0"
                          SelectionChanged="TrendComboBox_SelectionChanged">
                    <ComboBoxItem Content="Temperature"/>
                    <ComboBoxItem Content="Pressure"/>
                    <ComboBoxItem Content="Material Moisture"/>
                    <ComboBoxItem Content="Drying Rate"/>
                </ComboBox>

                <TextBlock x:Name="CurrentValueTextBlock"
                           Grid.Column="3"
                           Text="Current: 0.0"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main chart -->
        <Border Grid.Row="2"
                Background="#252525"
                BorderBrush="#777"
                BorderThickness="1"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ChartTitleTextBlock"
                           Text="Temperature [°C]"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Canvas x:Name="MainTrendCanvas"
                        Grid.Row="1"
                        Background="#1E1E1E"/>
            </Grid>
        </Border>
    </Grid>
</Window>