<Window x:Class="DiplomWork_Ivan_2026.TrendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Trends"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        Background="#878787"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Vacuum Dryer Process Trends"
               Grid.Column="0"
               Foreground="White"
               FontSize="26"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
            Grid.Column="1"
            Content="CLOSE"
            Width="125"
            Height="45"
            Background="#B71C1C"
            Foreground="White"
            FontWeight="Bold"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="CloseButton_Click"/>
        </Grid>

        <GroupBox Grid.Row="1"
                  Header="Temperature [°C]"
                  Foreground="White"
                  Margin="0,10,0,10">
            <Canvas x:Name="TemperatureCanvas"
                    Background="#252525"/>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="Pressure [kPa]"
                  Foreground="White"
                  Margin="0,10,0,10">
            <Canvas x:Name="PressureCanvas"
                    Background="#252525"/>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="Material Moisture [%]"
                  Foreground="White"
                  Margin="0,10,0,0">
            <Canvas x:Name="MoistureCanvas"
                    Background="#252525"/>
        </GroupBox>

    </Grid>
</Window>