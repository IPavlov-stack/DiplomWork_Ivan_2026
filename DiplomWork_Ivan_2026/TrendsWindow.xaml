<Window x:Class="DiplomWork_Ivan_2026.TrendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Trends"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        Background="#595959"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Vacuum Dryer Process Trends"
               Grid.Column="0"
               Foreground="White"
               FontSize="26"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
            Grid.Column="1"
            Content="CLOSE"
            Width="125"
            Height="45"
            Background="#B71C1C"
            Foreground="White"
            FontWeight="Bold"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="CloseButton_Click"/>
        </Grid>

        <Border Grid.Row="1"
        Background="#252525"
        BorderBrush="#555"
        BorderThickness="1"
        Margin="0,5,0,5"
        Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Temperature [°C]"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                    <TextBlock x:Name="TemperatureCurrentTextBlock"
                       Grid.Column="1"
                       Text="Current: 0.0"
                       Foreground="OrangeRed"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>

                <Canvas x:Name="TemperatureCanvas"
                Grid.Row="1"
                Background="#1E1E1E"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
        Background="#252525"
        BorderBrush="#555"
        BorderThickness="1"
        Margin="0,5,0,5"
        Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Pressure [kPa]"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                    <TextBlock x:Name="PressureCurrentTextBlock"
                       Grid.Column="1"
                       Text="Current: 0.0"
                       Foreground="DeepSkyBlue"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>

                <Canvas x:Name="PressureCanvas"
                Grid.Row="1"
                Background="#1E1E1E"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
        Background="#252525"
        BorderBrush="#555"
        BorderThickness="1"
        Margin="0,5,0,5"
        Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Material Moisture [%]"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                    <TextBlock x:Name="MoistureCurrentTextBlock"
                       Grid.Column="1"
                       Text="Current: 0.0"
                       Foreground="LimeGreen"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>

                <Canvas x:Name="MoistureCanvas"
                Grid.Row="1"
                Background="#1E1E1E"/>
            </Grid>
        </Border>
        <Border Grid.Row="4"
        Background="#252525"
        BorderBrush="#555"
        BorderThickness="1"
        Margin="0,5,0,0"
        Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Drying Rate [%/min]"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                    <TextBlock x:Name="DryingRateCurrentTextBlock"
                       Grid.Column="1"
                       Text="Current: 0.0"
                       Foreground="Gold"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>

                <Canvas x:Name="DryingRateCanvas"
                Grid.Row="1"
                Background="#1E1E1E"/>
            </Grid>
        </Border>

    </Grid>
</Window>