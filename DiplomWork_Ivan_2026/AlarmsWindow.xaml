<Window x:Class="DiplomWork_Ivan_2026.AlarmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm History"
        Width="1600"
        Height="900"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        Background="#595959"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
               Text="Vacuum Dryer Alarm History"
               Foreground="White"
               FontSize="26"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
            Grid.Column="1"
            Content="CLOSE"
            Width="125"
            Height="45"
            Background="#B71C1C"
            Foreground="White"
            FontWeight="Bold"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="CloseButton_Click"/>
        </Grid>

        <!-- SUMMARY -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock x:Name="ActiveAlarmsCountTextBlock"
                       Text="Active alarms: 0"
                       Foreground="OrangeRed"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,30,0"/>

            <TextBlock x:Name="TotalAlarmsCountTextBlock"
                       Text="Total alarms: 0"
                       Foreground="LightGray"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,30,0"/>

            <Button Content="REFRESH"
                    Width="110"
                    Height="32"
                    Background="#1565C0"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="RefreshButton_Click"/>

        </StackPanel>

        <!-- ALARM TABLE -->
        <DataGrid x:Name="AlarmHistoryDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="#252525"
                  Foreground="White"
                  RowBackground="#2B2B2B"
                  AlternatingRowBackground="#333333"
                  BorderBrush="#555"
                  BorderThickness="1"
                  FontSize="14"
                  Margin="0,10,0,10">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="BorderBrush" Value="#555"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                <DataGridTextColumn Header="Priority"
                                    Binding="{Binding Priority}"
                                    Width="110"/>

                <DataGridTextColumn Header="Date"
                                    Binding="{Binding Date}"
                                    Width="130"/>

                <DataGridTextColumn Header="Time"
                                    Binding="{Binding Time}"
                                    Width="110"/>

                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type}"
                                    Width="190"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

      

    </Grid>
</Window>